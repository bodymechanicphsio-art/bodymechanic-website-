# Google Search Console — paste your verification code from
# https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# =============================================================
# Google Places API (live review count + list from Google Maps)
# =============================================================
# When BOTH values are set, the homepage badge + testimonials section
# auto-pull the current rating, review count, and up to 5 latest reviews
# from Google every hour. Missing either value = site falls back to
# the hardcoded values in lib/constants/clinic.ts + content.ts
# (nothing breaks).
#
# Setup (one time, ~15 minutes):
#   1. Google Cloud Console → enable "Places API (New)"
#      https://console.cloud.google.com/google/maps-apis/start
#   2. Create an API key restricted to Places API.
#   3. Find the clinic's Place ID:
#      https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
#   4. Add both values here (local) and in Vercel → Project → Settings → Environment Variables.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
